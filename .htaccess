Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteBase /ccdeqbot/

# Bloquea el código privado del backend aunque se encuentre dentro de public_html.
RewriteRule ^back/app(?:/|$) - [F,L,NC]

# No interceptar archivos reales, carpetas reales ni llamadas al backend.
RewriteCond %{REQUEST_URI} !^/ccdeqbot/back/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
